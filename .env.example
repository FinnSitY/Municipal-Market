# Copy this file to .env.local (already git-ignored) and fill in your own values.
# Find them in Supabase Dashboard → Project Settings → API (or "API Keys").

# Your project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# The PUBLISHABLE key (sb_publishable_...) or the legacy "anon public" key.
# It is safe in the browser because Row Level Security protects the data.
# NEVER put the service_role / secret key (sb_secret_...) here: every VITE_ variable
# is bundled into the public JavaScript. The app refuses to start if it detects one.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Development only: set to true to use the offline localStorage demo data instead of
# Supabase. Ignored in production builds (npm run build).
VITE_USE_MOCK_DATA=false
